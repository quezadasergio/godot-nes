static func texture_for(key: String) -> Texture2D:
	var k := key.to_lower().strip_edges().replace(" ", "_").replace("-", "_")
	if TEXTURES.has(k):
		var pre: Variant = TEXTURES[k]
		if pre is Texture2D:
			return pre as Texture2D
	if CTEX_PATHS.has(k):
		var path := String(CTEX_PATHS[k])
		if ResourceLoader.exists(path):
			var loaded: Resource = ResourceLoader.load(path)
			if loaded is Texture2D:
				return loaded as Texture2D
	return null

