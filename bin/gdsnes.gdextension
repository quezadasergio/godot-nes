[configuration]

entry_symbol = "gdsnes_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

macos.debug = "res://bin/macos/libgdsnes.macos.template_debug.arm64.dylib"
macos.debug.arm64 = "res://bin/macos/libgdsnes.macos.template_debug.arm64.dylib"
macos.debug.universal = "res://bin/macos/libgdsnes.macos.template_debug.dylib"
macos.release = "res://bin/macos/libgdsnes.macos.template_release.arm64.dylib"
macos.release.arm64 = "res://bin/macos/libgdsnes.macos.template_release.arm64.dylib"
macos.release.universal = "res://bin/macos/libgdsnes.macos.template_release.dylib"

windows.debug.x86_64 = "res://bin/windows/gdsnes.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/gdsnes.windows.template_release.x86_64.dll"

linux.debug.x86_64 = "res://bin/linux/libgdsnes.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/libgdsnes.linux.template_release.x86_64.so"

web.debug.wasm32 = "res://bin/web/libgdsnes.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/web/libgdsnes.web.template_release.wasm32.nothreads.wasm"

[dependencies]

macos.debug = {}
macos.release = {}
web.debug.wasm32 = {}
web.release.wasm32 = {}
